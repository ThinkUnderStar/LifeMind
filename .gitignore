############################################################
# LifeMind 统一忽略规则（全仓库仅此一份，各模块不再单独维护）
# 说明：不带前导斜杠的模式（如 target/、build/）在任何层级都匹配，
#      因此可以直接覆盖 life-mind-account / -gateway / -message / -agent。
############################################################

# ============ AI 助手工作区数据 ============
.workbuddy/

# ============ 操作系统 ============
.DS_Store
Thumbs.db
desktop.ini

# ============ 本地敏感配置（密钥、密码统一放 Nacos，禁止提交） ============
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
*-local.yaml
*-local.yml

# ============ IntelliJ IDEA ============
.idea/
*.iws
*.iml
*.ipr

# ============ Eclipse / STS ============
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# ============ NetBeans ============
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/

# ============ VS Code / 其他编辑器 ============
.vscode/
*.swp

# ============ Java / Maven 构建产物 ============
target/
out/
build/
dist/
*.class
HELP.md
**/.mvn/wrapper/maven-wrapper.jar

# ============ Python 缓存与产物 ============
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# ============ 本地启动 / 运维脚本（只留在开发者本机，不进仓库） ============
# 根目录 /scripts/：start/stop/status-backend.ps1 与「启动后端.cmd」入口，
# 纯本机便利，路径与 jar 名写死，换机器必然要改，所以不纳入版本管理。
# 必须带前导斜杠锚定根目录：life-mind-web/scripts/dev.mjs 是构建链路的一部分，仍要跟踪。
/scripts/

# ============ 日志与临时文件 ============
*.log
logs/
# 启动脚本把各服务 stdout/stderr 落在这里
.runlogs/
# 临时构建 + 截图，用于没有 dev server 时验页面效果，验证完即弃
.tmp_shot/
*.tmp
*.bak
*.orig
*.rej

# ============ 运行时缓存 ============
# rag_component 用 LocalFileStore(EMBEDDING_CACHE_PATH) 落盘的向量缓存，随查询增长，
# 属于本机运行时状态，换台机器就该重建
embedding_cache.db/
